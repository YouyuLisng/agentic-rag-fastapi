ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Supabase Postgres connection string (Session pooler recommended for
# local dev; use the direct connection or transaction pooler for
# serverless deploys depending on target).
DATABASE_URL=

# Comma-separated allowed frontend origins for CORS. Defaults to local
# dev only (http://localhost:3000,http://localhost:3001) if unset --
# add the deployed frontend's real origin here in production.
CORS_ORIGINS=

# Optional: LLM tracing (Langfuse). Both implementations' agent loops
# emit traces when these are set -- leave unset and the Langfuse client
# just no-ops (no crash, no network calls). Get keys from
# https://cloud.langfuse.com (or your self-hosted instance's) project
# settings.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Only needed for a self-hosted Langfuse instance; the EU cloud is the
# default when unset.
LANGFUSE_HOST=
