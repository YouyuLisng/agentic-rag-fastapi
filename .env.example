ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Supabase Postgres connection string (Session pooler recommended for
# local dev; use the direct connection or transaction pooler for
# serverless deploys depending on target).
DATABASE_URL=

# Comma-separated allowed frontend origins for CORS. Defaults to local
# dev only (http://localhost:3000,http://localhost:3001) if unset --
# add the deployed frontend's real origin here in production.
CORS_ORIGINS=
